# .env.testing
APP_ENV=testing
APP_KEY=           # Generate yours with php artisan key:generate --env=testing
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=verita_testing
DB_USERNAME=your_username
DB_PASSWORD=your_password

MAIL_MAILER=array
QUEUE_CONNECTION=sync
CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_CLIENT=phpredis

JWT_SECRET=         #generate yours with php artisan jwt:secret --env=testing
